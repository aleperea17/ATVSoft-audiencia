# Copiar a .env en la raíz. Los secretos van vacíos: generarlos, no reutilizar un default.
#   openssl rand -hex 32

POSTGRES_DB=audiencia
POSTGRES_USER=audiencia
POSTGRES_PASSWORD=
DB_HOST=audiencia-db

ECOSYSTEM_SESSION_SECRET=
MANYCHAT_WEBHOOK_TOKEN=

# Token de larga duración de la cuenta profesional y el Instagram Business Account ID.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v25.0

# Claude CLI dentro del contenedor. Si está vacío, el CLI tiene que tener sesión propia.
ANTHROPIC_API_KEY=
CLAUDE_BIN=claude

# Orígenes del browser que pueden llamar a la API con la cookie. En producción, el dominio del módulo.
CORS_ORIGINS=https://audiencia.atvos.io,http://localhost:5173,http://127.0.0.1:5173

BACKEND_PORT=8020
FRONTEND_PORT=3020
